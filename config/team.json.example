{
  "_comment": "team.json 模板。复制为 config/team.json 并填入你自己的值。本模板全部为虚构占位值，不含任何真实数据。",
  "default_account": "bot01",
  "accounts": {
    "bot01": {
      "engineer": "Alice",
      "open_id": "ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    },
    "bot02": {
      "engineer": "Bob",
      "open_id": "ou_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
    }
  },
  "max_attempts": 3,
  "agents": {
    "requirement-analyst": {"model_hint": "your-provider/your-model"},
    "architect": {"model_hint": "your-provider/your-model"},
    "code-reviewer": {"model_hint": "your-provider/your-model"},
    "coder": {"model_hint": "your-provider/your-model"},
    "tester": {"model_hint": "your-provider/your-model"},
    "ops": {"model_hint": "your-provider/your-model"}
  },
  "card": {
    "board_title": "🤖 {engineer}智能体 · 多Agent任务看板"
  },
  "_decision_comment": "O6 决策等待：限时未否决按 default_action 执行；tiers 档位文案可全量覆盖",
  "decision": {
    "timeout_seconds": 86400,
    "default_action": "approve",
    "tiers": {
      "low": {"label": "低危可逆 · 默认批准", "default_action": "approve", "timeout_seconds": 3600},
      "medium": {"label": "中危 · 限时未否决按默认策略执行", "default_action": "approve", "timeout_seconds": 86400},
      "high": {"label": "高危 · 默认否决（需明确批准）", "default_action": "reject", "timeout_seconds": 86400}
    }
  },
  "_decision_card_comment": "O6 决策卡文案（按钮/标题均可定制）",
  "decision_card": {
    "header_title": "🗳️ 任务决策待批",
    "approve_button": "✅ 批准",
    "reject_button": "❌ 否决",
    "defer_button": "↔️ 转交"
  },
  "_sweep_comment": "O7b 巡检阈值（秒）：running 无进展/待分配超龄/重试宽限",
  "sweep": {
    "stale_running_seconds": 7200,
    "pending_age_seconds": 21600,
    "waiting_retry_grace_seconds": 1800
  },
  "_alert_card_comment": "O7b 巡检告警卡文案",
  "alert_card": {
    "header_title": "🚨 流水线巡检告警"
  }
}
